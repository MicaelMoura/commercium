rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function tenantUserPath(empresaId) {
      return /databases/$(database)/documents/business/$(empresaId)/users/$(request.auth.uid);
    }

    function isTenantMember(empresaId) {
      return isSignedIn() && exists(tenantUserPath(empresaId));
    }

    function tenantRole(empresaId) {
      return get(tenantUserPath(empresaId)).data.acesso;
    }

    function hasTenantRole(empresaId, roles) {
      return isTenantMember(empresaId) && tenantRole(empresaId) in roles;
    }

    function isTenantAdmin(empresaId) {
      return hasTenantRole(empresaId, ['administrador']);
    }

    function isSystemAdmin() {
      return isTenantAdmin('tecmhaicky');
    }

    function isOperationalCollection(collectionName) {
      return collectionName in [
        'supplier',
        'products',
        'stock',
        'caixa_fechamento'
      ];
    }

    match /business/{empresaId} {
      allow get: if isTenantMember(empresaId) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow create: if false;
      allow update: if isSystemAdmin()
        && !request.resource.data.keys().hasAny(['senhaAdmin']);
      allow delete: if isSystemAdmin();

      match /users/{userId} {
        allow get: if isSignedIn()
          && (request.auth.uid == userId || isTenantAdmin(empresaId) || isSystemAdmin());
        allow list: if isTenantAdmin(empresaId) || isSystemAdmin();
        // Escritas passam pelas callable Functions para manter Auth e associação consistentes.
        allow create, update, delete: if false;
      }

      // Escritas destas coleções passam pelas callable Functions.
      match /sales/{vendaId} {
        allow read: if hasTenantRole(empresaId, ['usuario', 'administrador']);
        allow write: if false;
      }
      match /cashflow/{movimentoId} {
        allow read: if isTenantMember(empresaId);
        allow create: if hasTenantRole(empresaId, ['usuario', 'administrador'])
          && !request.resource.data.keys().hasAny(['vendaId']);
        allow update: if hasTenantRole(empresaId, ['usuario', 'administrador'])
          && !resource.data.keys().hasAny(['vendaId'])
          && !request.resource.data.keys().hasAny(['vendaId']);
        allow delete: if hasTenantRole(empresaId, ['usuario', 'administrador'])
          && !resource.data.keys().hasAny(['vendaId']);
      }
      match /orders/{comandaId} {
        allow read: if hasTenantRole(empresaId, ['usuario', 'administrador']);
        allow write: if false;
      }
      match /table_sessions/{mesaId} {
        allow read: if hasTenantRole(empresaId, ['usuario', 'administrador']);
        allow write: if false;
      }
      match /settings/{configId} {
        allow read: if hasTenantRole(empresaId, ['usuario', 'administrador']);
        allow write: if false;
      }

      match /{collectionName}/{documentId} {
        allow read: if isOperationalCollection(collectionName)
          && isTenantMember(empresaId);
        allow create, update, delete: if isOperationalCollection(collectionName)
          && hasTenantRole(empresaId, ['usuario', 'administrador']);
      }
    }

    match /plataform/vOyNkQyF32YgFkc1ijyy/{collectionName}/{documentId} {
      allow read: if isSignedIn() && collectionName in ['units', 'payments'];
      allow create, update, delete: if isSystemAdmin()
        && collectionName in ['units', 'payments'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
